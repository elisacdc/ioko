---
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Button from "../../components/Button.astro";
import { formationQuoteMail, url } from "../../lib/links";
import "../../styles/formation-detail.css";

export async function getStaticPaths() {
  return (await getCollection("formations")).map((training) => ({
    params: { slug: training.data.slug },
    props: { training },
  }));
}

interface Props {
  training: CollectionEntry<"formations">;
}

const { training } = Astro.props;
const t = training.data;
const { Content } = await render(training);
const articles = await getCollection("articles");
const relatedArticles = t.relatedArticles
  .map((slug) => articles.find((entry) => entry.data.slug === slug))
  .filter((entry) => entry !== undefined);
const days = Number(t.duration.match(/(\d+)\s*jour/i)?.[1] ?? 0);
const groupPrice =
  days === 1
    ? "À partir de 1 450 € TTC pour le groupe"
    : days === 2
      ? "À partir de 2 900 € TTC pour le groupe"
      : "Tarif à compléter selon la durée de la formation.";
---

<Layout
  title={t.seoTitle ?? `Formation ${t.title}`}
  description={t.metaDescription ?? t.description}
  noindex={t.demo}
  ogImage={t.illustration}
  ogImageAlt={t.illustrationAlt}
  structuredData={[
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "Accueil",
          item: new URL(url(""), Astro.site).href,
        },
        {
          "@type": "ListItem",
          position: 2,
          name: "Formations",
          item: new URL(url("formations/"), Astro.site).href,
        },
        {
          "@type": "ListItem",
          position: 3,
          name: t.seoHeading ?? t.title,
          item: new URL(url(`formations/${t.slug}/`), Astro.site).href,
        },
      ],
    },
  ]}
>
  <section class="page-hero page-hero-illustrated training-detail-hero">
    <div class="container">
      <div class="training-detail-copy">
        <a class="back-link" href={url("formations/")}>
          ← Toutes les formations
        </a>
        <h1>{t.seoHeading ?? t.title}</h1>
        {t.seoHeading && <p class="lead training-detail-subtitle">{t.title}</p>}
        {t.demo && (
          <p class="demo-note">
            Formation de démonstration · programme et modalités à valider. Ne
            constitue pas une offre contractuelle.
          </p>
        )}
      </div>
      <figure class="training-detail-art">
        <span class="training-detail-art-sage" aria-hidden="true"></span>
        <span class="training-detail-art-terracotta" aria-hidden="true"></span>
        <img
          class="page-hero-art"
          src={url(t.illustration)}
          alt={t.illustrationAlt}
          width={t.illustrationWidth}
          height={t.illustrationHeight}
          fetchpriority="high"
        />
      </figure>
    </div>
  </section>

  <div class="container detail-layout section">
    <div class="prose">
      <section>
        <h2>Description</h2>
        {t.seoIntro && <p>{t.seoIntro}</p>}
        <Content />
      </section>
      <section>
        <h2>Public visé</h2>
        <p>{t.detailAudience ?? t.audience}</p>
        <h3>Capacité d’accueil</h3>
        <p>Groupe de 6 à 12 personnes</p>
      </section>
      <section>
        <h2>Objectifs pédagogiques</h2>
        <ul>
          {t.objectives.map((item) => <li>{item}</li>)}
        </ul>
      </section>
      <section>
        <h2>Programme</h2>
        <ol class="steps">
          {t.program.map((item) => (
            <li>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </li>
          ))}
        </ol>
      </section>
      <section>
        <h2>Moyens pédagogiques</h2>
        <ul>
          {t.methods.map((item) => <li>{item}</li>)}
        </ul>
      </section>
      <section>
        <h2>Modalités d’évaluation</h2>
        <p>{t.evaluation}</p>
      </section>
      <section>
        <h2>Prérequis</h2>
        <h3>Pour les apprenants</h3>
        <p>{t.learnerRequirements}</p>
        <h3>Prérequis techniques</h3>
        <p>{t.technicalRequirements}</p>
      </section>
      <section>
        <h2>Lieu</h2>
        <p>{t.location}</p>
      </section>
      <section>
        <h2>Accessibilité</h2>
        <p>{t.accessibility}</p>
      </section>
      {relatedArticles.length > 0 && (
        <section aria-labelledby="related-resources-title">
          <h2 id="related-resources-title">Ressources associées</h2>
          <ul>
            {relatedArticles.map((article) => (
              <li><a href={url(`ressources/${article.data.slug}/`)}>{article.data.title}</a></li>
            ))}
          </ul>
        </section>
      )}
      <Button href={formationQuoteMail(t.title)}>Demander un devis</Button>
      {t.faq && (
        <details class="faq-disclosure">
          <summary>
            <span class="faq-disclosure-title">Questions fréquentes</span>
            <span class="faq-disclosure-icon" aria-hidden="true"></span>
          </summary>
          <div class="faq-disclosure-content">
            {t.faq.map((item) => (
              <div>
                <h3>{item.question}</h3>
                <p>{item.answer}</p>
              </div>
            ))}
          </div>
        </details>
      )}
    </div>

    <aside class="practical">
      <p class="eyebrow">Votre formation</p>
      <h2>Informations pratiques</h2>
      <dl>
        <div>
          <dt>Durée</dt>
          <dd>{t.duration}</dd>
        </div>
        <div>
          <dt>Format</dt>
          <dd>{t.format}</dd>
        </div>
        <div>
          <dt>Lieu</dt>
          <dd>Le lieu sera défini ensemble selon les modalités de la formation.</dd>
        </div>
        <div>
          <dt>Modalités et délais d’accès</dt>
          <dd>{t.access}</dd>
        </div>
        <div>
          <dt>Tarif</dt>
          <dd>
            {groupPrice}
            <span class="small practical-pricing-note">
              Tarification sur devis selon les besoins et modalités de votre projet.
            </span>
          </dd>
        </div>
      </dl>
      <Button href={formationQuoteMail(t.title)}>Demander un devis</Button>
      <p class="small">
        Votre messagerie s’ouvrira avec une demande préremplie.
      </p>
      <a href={url("contact/")}>Échanger sur vos besoins</a>
      <p class="small practical-meta">
        Programme mis à jour le : {t.programUpdated}<br />
        Version : {t.programVersion}
      </p>
    </aside>
  </div>
</Layout>
