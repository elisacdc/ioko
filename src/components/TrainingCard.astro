---
import type { CollectionEntry } from "astro:content";
import { url } from "../lib/links";
interface Props {
  training: CollectionEntry<"formations">;
  index?: number;
  compact?: boolean;
  catalogue?: boolean;
  image?: string;
  imageAlt?: string;
}
const {
  training,
  index = 0,
  compact = false,
  catalogue = false,
  image,
  imageAlt = "",
} = Astro.props;
const t = training.data;
const audience = catalogue ? t.audience.replace(/\.$/, "") : t.audience;
---

<article class:list={[
  "training-card",
  compact || catalogue ? "training-card-compact" : undefined,
  catalogue && "training-card-catalogue",
]}>
  {image && <img class="training-card-image" src={image} alt={imageAlt} width={t.illustrationWidth} height={t.illustrationHeight} loading="lazy" />}
  {!compact && !catalogue && (
    <div class="card-top">
      <span class="eyebrow">{t.category}</span>
      <span class="card-number">{String(index + 1).padStart(2, "0")}</span>
    </div>
  )}
  {!compact && !catalogue && t.demo && (
    <span class="demo-label">Formation de démonstration</span>
  )}
  <h3>
    <a href={url(`formations/${t.slug}/`)}>{t.title}</a>
  </h3>
  <p>{t.description}</p>
  <dl class="card-facts">
    <div>
      <dt>Durée</dt>
      <dd>{t.duration}</dd>
    </div>
    <div>
      <dt>Format</dt>
      <dd>{t.format}</dd>
    </div>
    {!compact && (
      <div>
        <dt>Public</dt>
      <dd>{audience}</dd>
      </div>
    )}
  </dl>
  <a class="text-link" href={url(`formations/${t.slug}/`)}>
    Découvrir la formation <span aria-hidden="true">↗</span>
  </a>
</article>
