---
interface Props {
  label: string;
  accessibleLabel: string;
  href: string;
  icon: "linkedin" | "mail";
}

const { label, accessibleLabel, href, icon } = Astro.props;
const Tag = href ? "a" : "button";
---

<Tag
  class="resources-follow-button"
  href={href || undefined}
  type={href ? undefined : "button"}
  disabled={href ? undefined : true}
  aria-label={accessibleLabel}
>
  {icon === "linkedin" ? (
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.38-1.85 3.61 0 4.28 2.37 4.28 5.46v6.28zM5.33 7.43a2.06 2.06 0 1 1 .02-4.12 2.06 2.06 0 0 1-.02 4.12zm1.78 13.02H3.55V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.44c.98 0 1.79-.77 1.79-1.72V1.72C24 .77 23.2 0 22.22 0z" /></svg>
  ) : (
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5.5h18a1.5 1.5 0 0 1 1.5 1.5v10a1.5 1.5 0 0 1-1.5 1.5H3A1.5 1.5 0 0 1 1.5 17V7A1.5 1.5 0 0 1 3 5.5Zm0 2v.2l9 5.8 9-5.8v-.2H3Zm18 9.5V10l-8.46 5.45a1 1 0 0 1-1.08 0L3 10v7h18Z" /></svg>
  )}
  <span>{label}</span>
</Tag>
